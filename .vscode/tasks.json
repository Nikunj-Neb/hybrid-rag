{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend",
      "type": "process",
      "command": "${workspaceFolder}/hybrid-rag-starter/backend/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "main:app", "--reload", "--port", "8000"],
      "options": {"cwd": "${workspaceFolder}/hybrid-rag-starter/backend"},
      "problemMatcher": []
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {"cwd": "${workspaceFolder}/hybrid-rag-starter/frontend"},
      "problemMatcher": []
    }
  ]
}
